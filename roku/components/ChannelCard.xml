<?xml version="1.0" encoding="utf-8" ?>
<!-- Live TV tile, matching .grid.is-live .card-art in public/styles.css: a
     16/9 art box with the channel logo centred inside it, a LIVE pill in the
     top-left corner, and the channel name on its own line underneath the art
     rather than beside it. Roku's Rectangle has no corner radius, so the CSS
     radius is the one thing here that cannot be carried across. -->
<component name="ChannelCard" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContentChanged" />
    <field id="focusPercent" type="float" onChange="onFocusChanged" />
  </interface>

  <children>
    <!-- .card-art carries a 1px line-soft border that lightens on hover;
         two pixels of it survive being seen from a sofa. -->
    <Rectangle id="frame" width="288" height="164" color="0x2A211FFF" translation="[-2,-2]" />
    <Rectangle id="art" width="284" height="160" color="0x241C1AFF" />

    <Poster id="logo" width="224" height="112" translation="[30,24]" loadDisplayMode="scaleToFit" />

    <!-- .badge: dark translucent pill, pulsing dot, live text. The dot is a
         drawn square rather than a ● glyph, same reasoning as the pin marks. -->
    <Rectangle id="liveBadge" translation="[10,10]" width="78" height="26" color="0x080A0AC7">
      <Rectangle translation="[10,10]" width="6" height="6" color="0xFF6B5EFF" />
      <Label text="LIVE" translation="[24,0]" width="46" height="26" vertAlign="center"
             color="0xFF6B5EFF">
        <Font role="font" uri="pkg:/fonts/BebasNeue.ttf" size="21" />
      </Label>
    </Rectangle>

    <!-- Shown on anything this box has already failed to play. Sits across the
         foot of the art so it reads against the logo, not the title. -->
    <Rectangle id="blockedBar" width="284" height="30" translation="[0,130]" color="0x0B0807E6"
               visible="false">
      <Label text="WON'T PLAY HERE" width="284" height="30" horizAlign="center" vertAlign="center"
             color="0xFF6B5EFF">
        <Font role="font" uri="pkg:/fonts/DejaVuSans-Bold.ttf" size="17" />
      </Label>
    </Rectangle>

    <!-- Drawn, not a glyph — see PosterCard.xml. -->
    <Rectangle id="favMark" translation="[232,0]" width="52" height="8" color="0xA21F24FF"
               visible="false" />

    <!-- .card-title: full-strength text, two lines, under the art. -->
    <Label id="name" translation="[2,170]" width="280" height="48" wrap="true" maxLines="2"
           color="0xF6F1EEFF">
      <Font role="font" uri="pkg:/fonts/DejaVuSans.ttf" size="20" />
    </Label>
  </children>
  <!-- pkg:/source is the main scope, which SceneGraph components do not
       share. Shared helpers have to be pulled into each component's own
       namespace explicitly or every call to one fails at runtime with
       "Function is not defined in component's namespace". Included as a
       set so adding a helper does not mean editing twelve files. -->
  <script type="text/brightscript" uri="pkg:/source/Api.brs" />
  <script type="text/brightscript" uri="pkg:/source/Config.brs" />
  <script type="text/brightscript" uri="pkg:/source/Content.brs" />
  <script type="text/brightscript" uri="pkg:/source/Http.brs" />
  <script type="text/brightscript" uri="pkg:/source/Theme.brs" />
  <script type="text/brightscript" uri="pkg:/source/Util.brs" />
  <script type="text/brightscript" uri="pkg:/components/ChannelCard.brs" />
</component>
