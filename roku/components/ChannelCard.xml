<?xml version="1.0" encoding="utf-8" ?>
<!-- Live TV tile. Channel logos are wide and inconsistent, so these are
     landscape cards with the logo boxed on the left rather than posters. -->
<component name="ChannelCard" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContentChanged" />
    <field id="focusPercent" type="float" onChange="onFocusChanged" />
  </interface>

  <children>
    <Rectangle id="frame" width="396" height="122" color="0x241C1AFF" translation="[-3,-3]" />
    <Rectangle id="card" width="390" height="116" color="0x1D1715FF" />

    <Rectangle width="118" height="116" color="0x15100FFF">
      <Poster id="logo" width="98" height="96" translation="[10,10]" loadDisplayMode="scaleToFit" />
    </Rectangle>

    <Label id="name" translation="[136,20]" width="238" height="76" wrap="true" maxLines="3"
           color="0xA3928CFF">
      <Font role="font" uri="font:MediumSystemFontFile" size="24" />
    </Label>

    <!-- Drawn, not a glyph — see PosterCard.xml. -->
    <Rectangle id="favMark" translation="[338,0]" width="52" height="8" color="0xA21F24FF"
               visible="false" />
  </children>
  <!-- pkg:/source is the main scope, which SceneGraph components do not
       share. Shared helpers have to be pulled into each component's own
       namespace explicitly or every call to one fails at runtime with
       "Function is not defined in component's namespace". Included as a
       set so adding a helper does not mean editing twelve files. -->
  <script type="text/brightscript" uri="pkg:/source/Api.brs" />
  <script type="text/brightscript" uri="pkg:/source/Config.brs" />
  <script type="text/brightscript" uri="pkg:/source/Content.brs" />
  <script type="text/brightscript" uri="pkg:/source/Http.brs" />
  <script type="text/brightscript" uri="pkg:/source/Theme.brs" />
  <script type="text/brightscript" uri="pkg:/source/Util.brs" />
  <script type="text/brightscript" uri="pkg:/components/ChannelCard.brs" />
</component>
