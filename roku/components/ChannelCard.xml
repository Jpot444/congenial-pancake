<?xml version="1.0" encoding="utf-8" ?>
<!-- Live TV tile. Channel logos are wide and inconsistent, so these are
     landscape cards with the logo boxed on the left rather than posters. -->
<component name="ChannelCard" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContentChanged" />
    <field id="focusPercent" type="float" onChange="onFocusChanged" />
  </interface>

  <children>
    <!-- Card background with subtle shadow effect -->
    <Rectangle id="frame" width="396" height="180" color="0x3A2D2AFF" translation="[-3,-3]"
               cornerRadius="8" />
    <Rectangle id="card" width="390" height="174" color="0x241C1AFF" cornerRadius="8" />

    <!-- Logo container -->
    <Rectangle width="390" height="110" color="0x15100FFF" cornerRadius="8">
      <Poster id="logo" width="350" height="70" translation="[20,20]" loadDisplayMode="scaleToFit" />
    </Rectangle>

    <!-- LIVE badge -->
    <Rectangle id="liveBadge" translation="[12,12]" width="60" height="28" color="0xE50914FF"
               cornerRadius="4" visible="false">
      <Label text="● LIVE" translation="[8,2]" width="44" height="24" vertAlign="center"
             color="0xFFFFFFFF">
        <Font role="font" uri="pkg:/fonts/DejaVuSans-Bold.ttf" size="16" />
      </Label>
    </Rectangle>

    <!-- Title section -->
    <Label id="name" translation="[12,124]" width="366" height="50" wrap="true" maxLines="2"
           color="0xF6F1EEFF">
      <Font role="font" uri="pkg:/fonts/DejaVuSans-Bold.ttf" size="18" />
    </Label>

    <!-- Shown on anything this box has already failed to play. -->
    <Rectangle id="blockedBar" width="366" height="50" translation="[12,124]" color="0x0B0807CC"
               cornerRadius="4" visible="false">
      <Label text="WON'T PLAY HERE" width="366" height="50" horizAlign="center" vertAlign="center"
             color="0xFF6B5EFF">
        <Font role="font" uri="pkg:/fonts/DejaVuSans-Bold.ttf" size="16" />
      </Label>
    </Rectangle>

    <!-- Favorite indicator -->
    <Rectangle id="favMark" translation="[342,4]" width="48" height="8" color="0xA21F24FF"
               cornerRadius="2" visible="false" />
  </children>
  <!-- pkg:/source is the main scope, which SceneGraph components do not
       share. Shared helpers have to be pulled into each component's own
       namespace explicitly or every call to one fails at runtime with
       "Function is not defined in component's namespace". Included as a
       set so adding a helper does not mean editing twelve files. -->
  <script type="text/brightscript" uri="pkg:/source/Api.brs" />
  <script type="text/brightscript" uri="pkg:/source/Config.brs" />
  <script type="text/brightscript" uri="pkg:/source/Content.brs" />
  <script type="text/brightscript" uri="pkg:/source/Http.brs" />
  <script type="text/brightscript" uri="pkg:/source/Theme.brs" />
  <script type="text/brightscript" uri="pkg:/source/Util.brs" />
  <script type="text/brightscript" uri="pkg:/components/ChannelCard.brs" />
</component>
