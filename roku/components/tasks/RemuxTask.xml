<?xml version="1.0" encoding="utf-8" ?>
<!-- Starts a /api/remux conversion and waits for it to bank enough of a head
     start that playback runs through without stalling, reporting progress as
     it goes. Same handshake the web player does in waitForPrebuffer(). -->
<component name="RemuxTask" extends="Task">
  <interface>
    <!-- { kind, id, ext, vcodec, acodec, achannels } -->
    <field id="params" type="assocarray" />
    <!-- { ready, target, message } — updated about once a second. -->
    <field id="progress" type="assocarray" />
    <!-- { ok, url, session, duration, error } -->
    <field id="result" type="assocarray" />
    <!-- Set by the player when the user backs out mid-conversion. -->
    <field id="cancel" type="boolean" value="false" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/tasks/RemuxTask.brs" />
</component>
