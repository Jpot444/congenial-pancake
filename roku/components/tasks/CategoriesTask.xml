<?xml version="1.0" encoding="utf-8" ?>
<!-- The category list for one section, and nothing else. A few hundred rows of
     {category_id, category_name}, which is small enough to hold for all three
     sections at once — unlike the streams, which are fetched a category at a
     time. -->
<component name="CategoriesTask" extends="Task">
  <interface>
    <field id="section" type="string" />
    <!-- The same regex /api/prefs hands the web player, applied here because
         going direct to /api/xtream skips the server-side filtering that
         /api/library would have done. Empty means keep everything. -->
    <field id="pattern" type="string" />

    <!-- ContentNode whose children carry title and catId. -->
    <field id="catalog" type="node" />
    <field id="errorMessage" type="string" />
    <!-- Flips last, so observers see a complete result. -->
    <field id="done" type="boolean" value="false" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/Api.brs" />
  <script type="text/brightscript" uri="pkg:/source/Config.brs" />
  <script type="text/brightscript" uri="pkg:/source/Content.brs" />
  <script type="text/brightscript" uri="pkg:/source/Http.brs" />
  <script type="text/brightscript" uri="pkg:/source/Theme.brs" />
  <script type="text/brightscript" uri="pkg:/source/Util.brs" />
  <script type="text/brightscript" uri="pkg:/components/tasks/CategoriesTask.brs" />
</component>
