<?xml version="1.0" encoding="utf-8" ?>
<!-- Fetches one section of /api/library and turns it into a ContentNode tree
     on this thread. The parse and the node building are the expensive part —
     Movies runs to thousands of rows — and neither belongs on the render
     thread. Nodes cross the thread boundary by reference, so handing back a
     tree costs nothing, where handing back the raw arrays would deep-copy. -->
<component name="LibraryTask" extends="Task">
  <interface>
    <field id="section" type="string" />
    <field id="refresh" type="boolean" value="false" />

    <!-- Root ContentNode. Children are categories; their children are items. -->
    <field id="catalog" type="node" />
    <field id="errorMessage" type="string" />
    <field id="itemTotal" type="integer" value="0" />
    <!-- Flips last, so observers see a complete result. -->
    <field id="done" type="boolean" value="false" />
  </interface>
  <!-- pkg:/source is the main scope, which SceneGraph components do not
       share. Shared helpers have to be pulled into each component's own
       namespace explicitly or every call to one fails at runtime with
       "Function is not defined in component's namespace". Included as a
       set so adding a helper does not mean editing twelve files. -->
  <script type="text/brightscript" uri="pkg:/source/Api.brs" />
  <script type="text/brightscript" uri="pkg:/source/Config.brs" />
  <script type="text/brightscript" uri="pkg:/source/Content.brs" />
  <script type="text/brightscript" uri="pkg:/source/Http.brs" />
  <script type="text/brightscript" uri="pkg:/source/Theme.brs" />
  <script type="text/brightscript" uri="pkg:/source/Util.brs" />
  <script type="text/brightscript" uri="pkg:/components/tasks/LibraryTask.brs" />
</component>
