<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
  <interface>
    <field id="launchArgs" type="assocarray" />
  </interface>

  <children>
    <Rectangle width="1920" height="1080" color="0x15100FFF" />

    <!-- header -->
    <Poster uri="pkg:/images/icon_side_hd.png" translation="[60,34]" width="108" height="69" />

    <ButtonGroup id="nav" translation="[204,44]" layoutDirection="horiz" itemSpacings="[8]"
                 minWidth="150" />

    <Rectangle translation="[60,126]" width="1800" height="2" color="0x2A211FFF" />

    <!-- browse view -->
    <Group id="browse">
      <!-- .hero-title: the display face, uppercased in showTab. -->
      <Label id="sectionTitle" translation="[60,140]" width="900" height="66" color="0xF6F1EEFF">
        <Font role="font" uri="pkg:/fonts/BebasNeue.ttf" size="58" />
      </Label>

      <!-- The web player puts the count immediately under the title rather
           than out on the right margin. -->
      <Label id="sectionCount" translation="[62,206]" width="520" height="32"
             color="0x705F5AFF">
        <Font role="font" uri="pkg:/fonts/DejaVuSans.ttf" size="22" />
      </Label>

      <!-- .cat-section, the eyebrow over the sidebar. -->
      <Label id="categoriesHead" translation="[62,248]" width="520" height="26" text="CATEGORIES"
             color="0x705F5AFF">
        <Font role="font" uri="pkg:/fonts/BebasNeue.ttf" size="22" />
      </Label>

      <MarkupList id="categories" translation="[60,278]" itemSize="[520,58]" numRows="12"
                  itemComponentName="CategoryRow" drawFocusFeedback="false"
                  vertFocusAnimationStyle="floatingFocus" />

      <Label id="categoryEmpty" translation="[60,290]" width="520" height="120" wrap="true"
             color="0x705F5AFF" visible="false">
        <Font role="font" uri="pkg:/fonts/DejaVuSans.ttf" size="24" />
      </Label>

      <Label id="gridTitle" translation="[640,148]" width="1220" height="50" wrap="false"
             ellipsisText="…" color="0xF6F1EEFF">
        <Font role="font" uri="pkg:/fonts/BebasNeue.ttf" size="42" />
      </Label>

      <!-- 5 x 220 + 4 x 28 = 1212, inside the 1220 between the sidebar and the
           right margin. Cell height is art 330 + title 48 + rating line. -->
      <MarkupGrid id="posterGrid" translation="[640,214]" itemSize="[220,420]"
                  itemSpacing="[28,26]" numColumns="5" numRows="2"
                  itemComponentName="PosterCard" drawFocusFeedback="false"
                  vertFocusAnimationStyle="floatingFocus" visible="false" />

      <!-- 4 x 284 + 3 x 28 = 1220 exactly. Cell is a 284x160 16/9 art box plus
           the two title lines under it. -->
      <MarkupGrid id="liveGrid" translation="[640,214]" itemSize="[284,218]"
                  itemSpacing="[28,26]" numColumns="4" numRows="3"
                  itemComponentName="ChannelCard" drawFocusFeedback="false"
                  vertFocusAnimationStyle="floatingFocus" visible="false" />

      <Label id="gridEmpty" translation="[640,222]" width="1220" height="200" wrap="true"
             color="0x705F5AFF" visible="false">
        <Font role="font" uri="pkg:/fonts/DejaVuSans.ttf" size="28" />
      </Label>

      <Label id="browseHint" translation="[60,1014]" width="1800" height="34" color="0x705F5AFF">
        <Font role="font" uri="pkg:/fonts/DejaVuSans.ttf" size="22" />
      </Label>
    </Group>

    <!-- settings view -->
    <Group id="settings" visible="false">
      <Label translation="[60,140]" width="900" height="66" text="SETTINGS" color="0xF6F1EEFF">
        <Font role="font" uri="pkg:/fonts/BebasNeue.ttf" size="58" />
      </Label>

      <LabelList id="settingsList" translation="[60,240]" itemSize="[1000,72]" numRows="5"
                 color="0xA3928CFF" focusedColor="0xF6F1EEFF"
                 vertFocusAnimationStyle="floatingFocus">
        <Font role="font" uri="pkg:/fonts/DejaVuSans.ttf" size="28" />
        <Font role="focusedFont" uri="pkg:/fonts/DejaVuSans-Bold.ttf" size="28" />
      </LabelList>

      <Label id="settingsNote" translation="[60,560]" width="1300" height="200" wrap="true"
             color="0x705F5AFF">
        <Font role="font" uri="pkg:/fonts/DejaVuSans.ttf" size="24" />
      </Label>
    </Group>

    <!-- overlays -->
    <DetailView id="detail" visible="false" />
    <SeriesView id="series" visible="false" />
    <PlayerView id="player" visible="false" />
    <TextEntry id="textEntry" visible="false" />

    <Group id="loading" visible="false">
      <Rectangle width="1920" height="1080" color="0x0B0807E6" />
      <Label id="loadingText" translation="[360,466]" width="1200" height="64" horizAlign="center"
             color="0xF6F1EEFF">
        <Font role="font" uri="pkg:/fonts/BebasNeue.ttf" size="42" />
      </Label>
      <Rectangle id="progressTrack" translation="[660,560]" width="600" height="8"
                 color="0x2A211FFF" visible="false" />
      <Rectangle id="progressFill" translation="[660,560]" width="0" height="8"
                 color="0xA21F24FF" visible="false" />
      <Label id="loadingHint" translation="[360,610]" width="1200" height="40" horizAlign="center"
             color="0x705F5AFF" text="Press Back to cancel">
        <Font role="font" uri="pkg:/fonts/DejaVuSans.ttf" size="24" />
      </Label>
    </Group>
  </children>
  <!-- pkg:/source is the main scope, which SceneGraph components do not
       share. Shared helpers have to be pulled into each component's own
       namespace explicitly or every call to one fails at runtime with
       "Function is not defined in component's namespace". Included as a
       set so adding a helper does not mean editing twelve files. -->
  <script type="text/brightscript" uri="pkg:/source/Api.brs" />
  <script type="text/brightscript" uri="pkg:/source/Config.brs" />
  <script type="text/brightscript" uri="pkg:/source/Content.brs" />
  <script type="text/brightscript" uri="pkg:/source/Http.brs" />
  <script type="text/brightscript" uri="pkg:/source/Theme.brs" />
  <script type="text/brightscript" uri="pkg:/source/Util.brs" />
  <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
</component>
